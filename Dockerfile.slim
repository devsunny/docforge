# Slim image: native Rust engine only. No LibreOffice/Pandoc/Poppler/etc.
FROM rust:1.90-bookworm AS builder

WORKDIR /build
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY catalog ./catalog
COPY docs ./docs
RUN cargo build --release --locked -p docforge-server

FROM debian:bookworm-slim AS runtime

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

RUN useradd --system --uid 10001 --create-home --home-dir /data --shell /usr/sbin/nologin docforge \
    && mkdir -p /data \
    && chown -R docforge:docforge /data

COPY --from=builder /build/target/release/docforge /usr/local/bin/docforge

ENV DATA_DIR=/data \
    BIND_ADDR=0.0.0.0:8080 \
    PUBLIC_BASE_URL=http://localhost:8080 \
    AUTH_ISSUER=http://localhost:8080 \
    AUTH_DEMO_MODE=true \
    RUST_LOG=docforge=info

USER docforge
WORKDIR /data
EXPOSE 8080
VOLUME ["/data"]

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD curl -fsS http://127.0.0.1:8080/healthz || exit 1

ENTRYPOINT ["docforge"]
CMD ["serve"]

# DocForge configuration. Copy to .env and edit.
# Never commit a real .env.

# Network
BIND_ADDR=127.0.0.1:8080
PUBLIC_BASE_URL=http://127.0.0.1:8080

# OAuth mode:
#   embedded = DocForge's built-in OAuth 2.1 server (default for local cargo)
#   keycloak = external Keycloak realm (default in docker-compose.yml)
AUTH_MODE=embedded
AUTH_ISSUER=http://127.0.0.1:8080
AUTH_REST_RESOURCE=http://127.0.0.1:8080/api
AUTH_MCP_RESOURCE=http://127.0.0.1:8080/mcp

# Embedded mode login (also used by docker-compose.embedded.yml)
AUTH_USERNAME=demo
AUTH_PASSWORD=demo
AUTH_DEMO_MODE=true

# Dynamic client registration (embedded mode only)
AUTH_DCR_ENABLED=true
# AUTH_DCR_INITIAL_ACCESS_TOKEN=replace-with-a-long-random-token

# Token lifetimes (embedded mode, seconds)
AUTH_ACCESS_TOKEN_TTL=3600
AUTH_REFRESH_TOKEN_TTL=2592000
AUTH_AUTHORIZATION_CODE_TTL=300

# --- Keycloak mode ---------------------------------------------------------
# docker-compose.yml sets these for you. For `cargo run` against a local
# Keycloak, uncomment and set AUTH_MODE=keycloak above.
# KEYCLOAK_ISSUER=http://localhost:8081/realms/docforge
# KEYCLOAK_JWKS_URL=http://localhost:8081/realms/docforge/protocol/openid-connect/certs
# KEYCLOAK_AUTHORIZATION_ENDPOINT=http://localhost:8081/realms/docforge/protocol/openid-connect/auth
# KEYCLOAK_TOKEN_ENDPOINT=http://localhost:8081/realms/docforge/protocol/openid-connect/token
# KEYCLOAK_REGISTRATION_ENDPOINT=http://localhost:8081/realms/docforge/clients-registrations/openid-connect
# KEYCLOAK_REVOCATION_ENDPOINT=http://localhost:8081/realms/docforge/protocol/openid-connect/revoke
# KEYCLOAK_END_SESSION_ENDPOINT=http://localhost:8081/realms/docforge/protocol/openid-connect/logout
# AUTH_ISSUER=http://localhost:8081/realms/docforge
# AUTH_API_AUDIENCE=http://localhost:8080/api
# AUTH_MCP_AUDIENCE=http://localhost:8080/mcp

# Browser origins allowed to call the OAuth/API/MCP endpoints
AUTH_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:3000,http://127.0.0.1:3000,http://localhost:6274,http://127.0.0.1:6274
CORS_ALLOW_ANY=false
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:3000,http://127.0.0.1:3000,http://localhost:6274,http://127.0.0.1:6274

# Storage and limits
DATA_DIR=./data
MAX_UPLOAD_MB=100
MAX_SYNC_MB=25
CONVERSION_CONCURRENCY=4
CONVERSION_TIMEOUT_SECS=300
JOB_TTL_HOURS=24
MCP_MAX_INLINE_MB=16

# Logging
RUST_LOG=docforge=info,tower_http=info
